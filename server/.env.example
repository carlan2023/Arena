# Arena server settings. Copy to server/.env (never commit .env) and fill in.
# Only server/lib/config.dart reads these. Blank or missing means the default.

# --- Network -------------------------------------------------------------
# Listen address and port. Default 0.0.0.0 and 8080.
HOST=0.0.0.0
PORT=8080
# Public address of this server, used for room links (${PUBLIC_BASE_URL}/r/CODE)
# and payment callback URLs. Default http://localhost:8080.
# Staging: the https URL of the staging VM, for example https://staging.example.ug
PUBLIC_BASE_URL=http://localhost:8080
# Version shown by GET /health. Set by the deploy script from the git commit.
# Default dev.
APP_VERSION=dev
# Where the /r/CODE page sends people without the app (the website download).
# Default: no download link shown.
APP_DOWNLOAD_URL=

# --- Storage -------------------------------------------------------------
# Postgres for users, wallet and match log. Unset keeps everything in memory
# (lost on restart). Local: postgres://arena:arena@localhost:5432/arena
# Managed Postgres: from the provider's console, with ?sslmode=require.
# Without an sslmode parameter the connection is not encrypted.
DATABASE_URL=
# Redis for live rooms, so a restart keeps games going. Unset keeps rooms in
# memory only. Local: redis://localhost:6379. Format redis://[:password@]host:port[/db]
REDIS_URL=
# Hours a live room stays in Redis after its last change. Default 6.
LIVE_ROOM_TTL_HOURS=6

# --- Login ---------------------------------------------------------------
# Signs the server's own session tokens (decision D15). At least 32 bytes.
# Make one with: openssl rand -base64 48
# Required unless AUTH_PROVIDER and PAYMENTS_PROVIDER are both fake, in which
# case a random one is made at start and logins end on restart.
SESSION_SECRET=
# fake (default, accepts "fake:+256XXXXXXXXX" after code 123456, decision D16)
# or firebase.
AUTH_PROVIDER=fake
# Firebase project id: Firebase console > Project settings > General >
# Project ID. Required for firebase.
FIREBASE_PROJECT_ID=
# Path to a Firebase service account JSON file: Firebase console > Project
# settings > Service accounts > Generate new private key. Optional: ID token
# checks only need FIREBASE_PROJECT_ID. Keep the file outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=

# --- Payments ------------------------------------------------------------
# fake (default), or mtn, airtel, or mtn,airtel. The server refuses to start
# with AUTH_PROVIDER=fake and a real provider. With fake, every deposit goes to
# the fake provider and POST /v1/dev/payments/{id}/confirm completes it.
PAYMENTS_PROVIDER=fake
# MTN MoMo Collections API (https://momodeveloper.mtn.com).
# Subscription key: momodeveloper.mtn.com > Profile > Collections subscription
# (primary key). In production, from MTN Uganda when the account goes live.
MOMO_SUBSCRIPTION_KEY=
# API user (a UUID you choose) and API key: created once with the sandbox
# provisioning API (POST /v1_0/apiuser, then POST /v1_0/apiuser/{id}/apikey);
# in production, issued by MTN through the partner portal.
MOMO_API_USER=
MOMO_API_KEY=
# sandbox for testing, mtnuganda in production (given by MTN). Default sandbox.
MOMO_TARGET_ENVIRONMENT=sandbox
# API host. Default https://sandbox.momodeveloper.mtn.com; production host
# comes from MTN at go-live.
MOMO_BASE_URL=
# The sandbox only accepts EUR (decision D23). Default EUR; UGX in production.
MOMO_CURRENCY=EUR
# Public URL MTN calls back after a payment: this server's callback route.
# Default ${PUBLIC_BASE_URL}/v1/payments/callback/mtn. The host must also be
# registered as the callback host of the API user.
MOMO_CALLBACK_URL=
# Airtel Money Collections: https://developers.airtel.africa > My apps >
# the app's Client ID and Client Secret (UAT keys for testing, production keys
# after Airtel approves the app).
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
# Default https://openapiuat.airtel.africa (UAT). Production: https://openapi.airtel.africa
AIRTEL_BASE_URL=
# Optional: the callback hash secret set on the Airtel developer portal (app >
# callback settings). Callbacks are checked when it is set.
AIRTEL_CALLBACK_SECRET=

# --- Game timing and limits (README section 2, protocol.md) --------------
# Seconds per decision (a roll, or the move list after a roll). Default 20.
TURN_SECONDS=20
# Seconds a disconnected player has to rejoin. Default 60.
RECONNECT_GRACE_SECONDS=60
# Milliseconds a bot waits before acting. Default 800.
BOT_DELAY_MS=800
# Minutes before an empty waiting room, or a finished one, is dropped. Default 30.
ROOM_IDLE_MINUTES=30
# Rooms one user may create per hour. Default 10.
ROOM_CREATES_PER_HOUR=10
# Guest accounts one client address may start per hour. Default 30.
GUESTS_PER_HOUR=30
# Web socket messages per second per socket before rate_limited. Default 20.
WS_MESSAGES_PER_SECOND=20
